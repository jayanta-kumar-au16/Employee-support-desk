# Copy to .env. Replace the empty key locally and switch provider to openai.
# Existing terminal environment variables override this file.
AI_PROVIDER=offline
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
MODEL_TIMEOUT_SECONDS=20
MODEL_CALL_LIMIT=50

# Optional: if enabled, configure the same value in the Java environment.
# INTERNAL_SERVICE_TOKEN=
